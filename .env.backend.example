# Required because the container listens on 0.0.0.0. Generate a long random value.
LIVABILITY_API_KEY=
LIVABILITY_API_BIND_ADDRESS=127.0.0.1
LIVABILITY_API_PORT=8091
LIVABILITY_FRONTEND_BIND_ADDRESS=127.0.0.1
LIVABILITY_FRONTEND_PORT=5173
LIVABILITY_INTERNAL_NETWORK_NAME=livability-agent-internal
# UID/GID used only by the one-shot updater when it writes ./open_data.
# Linux usually uses 1000:1000; macOS commonly uses 501:20 (`id -u`, `id -g`).
LIVABILITY_HOST_UID=1000
LIVABILITY_HOST_GID=1000

# Zero-key data/LLM demo. DATA_MODE also accepts open_data for a validated local
# snapshot in ./open_data; open_data does not require ESTAT_APP_ID or REINFOLIB_API_KEY.
LLM_MODE=mock
DATA_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ESTAT_APP_ID=
REINFOLIB_API_KEY=
MOCK_LATENCY_MS=300
DATA_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=90
SPECIALIST_ATTEMPTS=2

# No-account official-data updater. It runs once before the API when
# DATA_MODE=open_data, then the API reads the validated files without HTTP calls.
OPEN_DATA_SYNC_SCOPE=nationwide
# Used only when OPEN_DATA_SYNC_SCOPE=selected.
OPEN_DATA_SYNC_REGIONS=
OPEN_DATA_SYNC_REQUEST_INTERVAL_SECONDS=0.25
OPEN_DATA_SYNC_MAX_AGE_HOURS=168
OPEN_DATA_SYNC_TIMEOUT_SECONDS=180
OPEN_DATA_INCLUDE_TRAFFIC=true
OPEN_DATA_TRAFFIC_CSV_URL=https://www.npa.go.jp/publications/statistics/koutsuu/opendata/2024/honhyo_2024.csv
OPEN_DATA_TRAFFIC_REFERENCE_YEAR=2024
# Optional pin. If set, a changed upstream file is rejected before publication.
OPEN_DATA_TRAFFIC_EXPECTED_SHA256=

# OpenWebUI Pipe registration. Shared administrator credentials come from the
# OpenWebUI platform's .env.admin; the token is only an optional compatibility path.
# Use an absolute path when the repositories do not share the documented directory layout.
OPENWEBUI_ADMIN_ENV_FILE=
OPENWEBUI_ADMIN_TOKEN=
OPENWEBUI_URL=http://openwebui:8080
LIVABILITY_BACKEND_URL=http://livability-agent-api:8091
LIVABILITY_PIPE_TIMEOUT_SECONDS=300
OPENWEBUI_REQUEST_TIMEOUT_SECONDS=30
OPENWEBUI_REGISTRATION_ATTEMPTS=30
OPENWEBUI_REGISTRATION_RETRY_SECONDS=2
